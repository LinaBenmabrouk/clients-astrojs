---
export const prerender = false;

if (Astro.locals.user) return Astro.redirect("/");

const googleEnabled = Boolean(
  import.meta.env.GOOGLE_CLIENT_ID && import.meta.env.GOOGLE_CLIENT_SECRET
);
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Connexion | Clients</title>

  <style>
    :root {
      --background: #f5f7fb;
      --card: #ffffff;
      --text: #172033;
      --muted: #718096;
      --border: #e7ebf2;
      --primary: #4f46e5;
      --error: #b00020;
      --shadow: 0 8px 30px rgba(15, 23, 42, 0.07);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 16px;
      background: var(--background);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    form {
      width: 100%;
      max-width: 380px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 28px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    h1 {
      margin: 0 0 8px;
      font-size: 24px;
    }

    input {
      padding: 11px 13px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font: inherit;
      font-size: 14px;
    }

    input:focus {
      outline: 2px solid var(--primary);
      outline-offset: -1px;
    }

    button {
      padding: 11px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: white;
      font: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    button:hover {
      background: #f8fafc;
    }

    .primary {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    .primary:hover {
      background: #4338ca;
    }

    #error {
      min-height: 1em;
      margin: 0;
      color: var(--error);
      font-size: 13px;
    }
  </style>
</head>

<body>
  <form id="form">
    <h1>Connexion</h1>
    <input name="name" placeholder="Nom (pour créer un compte)" />
    <input name="email" type="email" placeholder="Email" required />
    <input name="password" type="password" placeholder="Mot de passe (8 caractères min.)" required />
    <p id="error"></p>
    <button type="button" id="login" class="primary">Se connecter</button>
    <button type="button" id="signup">Créer un compte</button>
    {googleEnabled && <button type="button" id="google">Se connecter avec Google</button>}
  </form>

  <script>
    import { authClient } from "../lib/auth-client";

    const form = document.querySelector<HTMLFormElement>("#form")!;
    const error = document.querySelector("#error")!;

    async function submit(mode: "login" | "signup") {
      const d = new FormData(form);
      const email = d.get("email") as string;
      const password = d.get("password") as string;
      const name = (d.get("name") as string) || email;

      const { error: err } =
        mode === "login"
          ? await authClient.signIn.email({ email, password })
          : await authClient.signUp.email({ name, email, password });

      if (err) error.textContent = err.message ?? "Erreur";
      else window.location.href = "/";
    }

    document.querySelector("#login")!.addEventListener("click", () => submit("login"));
    document.querySelector("#signup")!.addEventListener("click", () => submit("signup"));
    document.querySelector("#google")?.addEventListener("click", () =>
      authClient.signIn.social({ provider: "google", callbackURL: "/" }),
    );
  </script>
</body>
</html>
